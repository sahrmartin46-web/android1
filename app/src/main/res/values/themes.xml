<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Day Light Theme -->
    <style name="Theme.SociaMediaBackend" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FE2C55</item>
        <item name="colorPrimaryVariant">#D62246</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#25F4EE</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">#F9FAFB</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111827</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Pill</item>
    </style>

    <style name="Widget.App.Button.Pill" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">21dp</item>
    </style>
</resources>
