<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎥 Advanced LIVE Setup"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Stream Title Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stream Title / Topic"
                app:boxStrokeColor="#FE2C55"
                app:hintTextColor="#FE2C55">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStreamTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Stream Quality Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAM RESOLUTION &amp; QUALITY"
                android:textColor="#25F4EE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuality720p"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="720p HD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:strokeColor="#25F4EE"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuality1080p"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="1080p Full HD"
                    android:textColor="#25F4EE"
                    android:textStyle="bold"
                    app:strokeColor="#25F4EE"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="22dp" />

            </LinearLayout>

            <!-- Live Features Toggles -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERACTIVE LIVE FEATURES"
                android:textColor="#25F4EE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMultiGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Enable Multi-Guest Grid (Up to 16)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                android:paddingVertical="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPkBattles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚔️ Enable PK Battles &amp; Match Bounties"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                android:paddingVertical="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGifts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎁 Enable Virtual Gifts &amp; Diamond Payouts"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                android:paddingVertical="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Enable Live Chat &amp; Comments"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:checked="true"
                android:paddingVertical="8dp" />

            <!-- Go LIVE Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoLiveNow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="🔴 Start Live Broadcast"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:background="@drawable/btn_primary_gradient"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
