<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#F9FAFB"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvProgramIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvProgramTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="LIVE Stream Virtual Gifts"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvProgramIcon"
            app:layout_constraintEnd_toStartOf="@id/tvStatusBadge" />

        <TextView
            android:id="@+id/tvPayoutRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Earn up to 100% of viewer gifts"
            android:textColor="#0D9488"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tvProgramTitle"
            app:layout_constraintStart_toStartOf="@id/tvProgramTitle"
            app:layout_constraintEnd_toStartOf="@id/tvStatusBadge" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FE2C55"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvProgramDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Receive virtual gifts from fans during live streams and convert them directly to withdrawable cash."
            android:textColor="#374151"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            app:layout_constraintTop_toBottomOf="@id/tvPayoutRate" />

        <TextView
            android:id="@+id/tvRequirement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:text="Requirement: 1,000 Followers"
            android:textColor="#6B7280"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tvProgramDesc"
            app:layout_constraintBottom_toBottomOf="@id/btnManageProgram"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnManageProgram" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageProgram"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="Manage"
            android:textColor="#111827"
            app:strokeColor="#D1D5DB"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvProgramDesc"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
