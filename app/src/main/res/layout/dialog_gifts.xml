<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161823"
    android:padding="20dp">

    <!-- Header & Coins Balance -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 Send Live Gift"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:id="@+id/llCoinsBalance"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="#222534"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCoinsBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 1,000 Coins"
                android:textColor="#25F4EE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBuyCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+ Buy"
                android:textColor="#FE2C55"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2F3241"
        android:layout_marginBottom="16dp" />

    <!-- Gifts Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

</LinearLayout>
