<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- FUGEN LIVE Multi-Guest RecyclerView Grid (1, 2, 3, 4, 6, 9, 16 Persons) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLiveGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/clTopBar"
        app:layout_constraintBottom_toTopOf="@id/llBottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar: Close, Host Avatar, Live Badge, Layout Switcher -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCloseViewer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#80000000"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Close Viewer" />

        <ImageView
            android:id="@+id/ivHostAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:src="@android:color/darker_gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCloseViewer"
            android:contentDescription="Host Avatar" />

        <TextView
            android:id="@+id/tvViewerHostName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivHostAvatar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnSwitchLayout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="#80000000"
                android:src="@android:drawable/ic_menu_crop"
                app:tint="#25F4EE"
                android:contentDescription="Switch Layout" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FE2C55"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvViewerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="👁 1.2K"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Gifts Animation Overlay Banner -->
    <TextView
        android:id="@+id/tvGiftBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FE2C55"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/clTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Bottom Controls: Chat Log, Chat Input, Gift Button -->
    <LinearLayout
        android:id="@+id/llBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Chat Log -->
        <ScrollView
            android:id="@+id/scrollViewerChat"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvViewerChatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Joined live stream. Say hi!"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

        <!-- Chat Input & Gift Drawer Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etViewerChat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="#80161823"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8B91"
                android:hint="Add a comment..."
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnSendViewerChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="#222534"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF"
                android:contentDescription="Send" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGifts"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="🌹 Gift"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#FE2C55"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
