<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Material Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:title="Settings &amp; Privacy"
        app:titleTextColor="#111827"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#111827" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Canva Inspired Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FDF2F8"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FBCFE8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨 FUGEN LIVE Settings &amp; Privacy Center"
                        android:textColor="#BE185D"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Production account security, privacy controls, and preferences"
                        android:textColor="#831843"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Server Connection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER CONNECTION"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBaseUrl"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="API Server Base URL"
                        app:boxStrokeColor="#FE2C55"
                        app:hintTextColor="#FE2C55">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBaseUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#111827"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="12dp"
                        android:text="Save &amp; Test Connection"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FE2C55"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Account Management -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT MANAGEMENT"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccountManagement"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="👤 Account Management (Identity &amp; Security)"
                        android:textColor="#0D9488"
                        app:strokeColor="#0D9488"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrivacyControls"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="🛡️ Privacy &amp; Audience Controls"
                        android:textColor="#0D9488"
                        app:strokeColor="#0D9488"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContentPreferences"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="⏳ Content Preferences &amp; Screen Time"
                        android:textColor="#0D9488"
                        app:strokeColor="#0D9488"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Creator Economy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATOR ECONOMY"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonetizationHub"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="💰 Creator Monetization Programs"
                        android:textColor="#0D9488"
                        app:strokeColor="#0D9488"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Privacy & Audience Controls -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIVACY &amp; INTERACTION CONTROLS"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPrivateAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Private Account (Require Approval)"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingVertical="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBlockedUsers"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="🚫 Blocked Accounts"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKeywordFilters"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="🔤 Comment Keyword Filters"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Login Security & Sessions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGIN SECURITY &amp; SESSIONS"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageSessions"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="📱 Active Device Sessions"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePassword"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="🔒 Change Password"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 5: Data Saver & Playback -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA SAVER &amp; PLAYBACK"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDataSaver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data Saver (Lower Video Resolution)"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingVertical="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="8dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Autoplay Videos on Cellular Data"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingVertical="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearCache"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="🧹 Clear Media Cache"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 6: Notifications & Quiet Hours -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATIONS &amp; QUIET HOURS"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchLiveAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="LIVE Stream Notifications"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingVertical="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="8dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCommentsAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Comments &amp; Likes Notifications"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingVertical="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 7: Account Lifecycle & Data Export -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT LIFECYCLE &amp; DATA EXPORT"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportData"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="📥 Download My Data Export"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeactivateAccount"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="⏸️ Deactivate Account Temporarily"
                        android:textColor="#D97706"
                        app:strokeColor="#FCD34D"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteAccount"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="⚠️ Delete Account Permanently"
                        android:textColor="#DC2626"
                        app:strokeColor="#FCA5A5"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 8: About & Policies -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT &amp; POLICIES"
                android:textColor="#0D9488"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Version: v1.0.0 (Fugen Studio)"
                        android:textColor="#111827"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNativeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Native Engine: Active (16KB Page Aligned)"
                        android:textColor="#0D9488"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCommunityGuidelines"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="Community Guidelines &amp; Policy"
                        android:textColor="#111827"
                        app:strokeColor="#D1D5DB"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="19dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Sign Out"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FE2C55"
                app:cornerRadius="22dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
