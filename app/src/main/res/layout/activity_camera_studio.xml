<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TikTok Style Immersive Vertical Camera Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Floating Toolbar (Fully visible below notch) -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            android:contentDescription="Close" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Timer / Recording Countdown Display -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FE2C55"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginEnd="16dp" />

        <!-- Flash Toggle -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_translucent"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#FFFFFF"
            android:contentDescription="Flash" />

        <!-- Camera Flip -->
        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_translucent"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF"
            android:contentDescription="Flip Camera" />

    </LinearLayout>

    <!-- TikTok Style Right-Side Vertical Tools Column -->
    <LinearLayout
        android:id="@+id/llSideTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/llTopBar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <!-- Filters Tool -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudioFilters"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:backgroundTint="#88000000"
            app:strokeColor="#25F4EE"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp"
            android:contentDescription="Filters" />

        <!-- Pick Audio Sound Tool -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickAudioSound"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#25F4EE"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:backgroundTint="#88000000"
            app:strokeColor="#25F4EE"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp"
            android:contentDescription="Audio Sound" />

    </LinearLayout>

    <!-- Hidden Filter Buttons for Activity Binding -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/filterBeauty" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterNormal" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterGrayscale" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterSepia" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterSunset" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterCool" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- TikTok Style Horizontal Scrolling Bottom Navigation & Shutter Dock -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="56dp"
        android:gravity="center"
        android:background="#22000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Quality & Duration Selector Chips (2s, 5s, 8s, 10s, 15s) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView android:id="@+id/quality4k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 4K UHD " android:textColor="#4edea3" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:background="#33000000"/>
            <TextView android:id="@+id/quality1080p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 1080P " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/dur2s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 2s " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="12dp"/>
            <TextView android:id="@+id/dur5s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 5s " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/dur8s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 8s " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/dur10s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 10s " android:textColor="#FE2C55" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/dur15s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 15s " android:textColor="#25F4EE" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="6dp" android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- HORIZONTAL SCROLLABLE ROUNDED PILL DOCK -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="false"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Gallery Pic (Fully Rounded Pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPicture"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:text="🖼️ Pic"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#99000000"
                    app:strokeColor="#25F4EE"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="20dp" />

                <!-- Gallery Vid (Fully Rounded Pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:text="🎬 Vid"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#99000000"
                    app:strokeColor="#25F4EE"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="20dp" />

                <!-- Snip Photo (Fully Rounded Pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSnapPicture"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:text="📸 Snip"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#25F4EE"
                    app:cornerRadius="20dp" />

                <!-- TIKTOK STYLE CENTRAL FULLY ROUNDED CIRCULAR SHUTTER RECORD BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecordTimedVideo"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_marginHorizontal="8dp"
                    android:text="🔴"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="#FE2C55"
                    app:cornerRadius="41dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="4dp"
                    android:contentDescription="Record Video" />

                <!-- Go Live (Fully Rounded Pill) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoLive"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="10dp"
                    android:text="📡 Live"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#7C3AED"
                    app:cornerRadius="20dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
